class Widget:
    def __init__(self) -> None: ...

    def measure(self, constraints: Constraints) -> Size:
        """
        Override: intrinsic size under `constraints`; return constraints.clamp(Size(w, h)). Layout runs in Context.tick(), not render() — bounds are zero until the first tick.
        """

    def arrange(self, area: Rect) -> None:
        """
        Runs the C++ arrange (custom containers call this on their child after assigning their own bounds).
        """

    def paint(self, env: PaintEnv) -> None:
        """
        Override: append draw commands to env.list (rect, hollow_rect, line, circle, image, push_clip/pop_clip) using env.theme colors, in absolute coordinates (self.bounds). Painted BEFORE children; see paint_over for drawing on top of them.
        """

    def paint_over(self, env: PaintEnv) -> None:
        """
        Override: drawn AFTER (on top of) the children, outside this widget's clip_rect — decorations over wrapped widgets.
        """

    def clip_rect(self) -> Rect | None:
        """Override: Rect to clip the children to while painting, or None."""

    def attached(self, context: Context) -> None:
        """
        Override: called once when the widget joins a Context (on the first tick after it was added).
        """

    def on_event(self, event: Event) -> bool:
        """
        Override: return True to consume. Mouse events (MouseMove, MousePress, MouseRelease, Click, DoubleClick, Scroll) reach the widget under the pointer — or the mouse-capture widget — and bubble to ancestors until consumed; every button is delivered (check event.button). Key events go to the focused widget (falling back to the hovered one) and bubble; KeyRelease only follows a KeyPress the widget tree received. TextInput needs focus (focusable() -> True). MouseEnter/MouseLeave and FocusGained/FocusLost go to the affected widget only. Use context.capture_mouse(self) on press so a drag keeps receiving moves and the release outside your bounds.
        """

    def tick(self, time: Time) -> None:
        """
        Override: per-frame update; time.now / time.dt in seconds. Use this clock, not wall time, for animation.
        """

    def stretch_cross(self) -> bool: ...

    def expands_main(self) -> bool: ...

    def focusable(self) -> bool: ...

    def widget_type(self) -> str: ...

    @property
    def id(self) -> str: ...

    @id.setter
    def id(self, arg: str, /) -> None: ...

    @property
    def visible(self) -> bool: ...

    @visible.setter
    def visible(self, arg: bool, /) -> None: ...

    @property
    def enabled(self) -> bool: ...

    @enabled.setter
    def enabled(self, arg: bool, /) -> None: ...

    @property
    def focused(self) -> bool:
        """True while this widget holds keyboard focus."""

    @property
    def context(self) -> Context:
        """
        The Context this widget is attached to (None until the first tick after it joined a tree).
        """

    def request_focus(self) -> None:
        """Give this widget keyboard focus (it receives FocusGained)."""

    def set_cursor(self, cursor: Cursor) -> Widget:
        """Cursor shape requested while hovered (needs a cursor host)."""

    @property
    def type(self) -> str: ...

    @property
    def tooltip(self) -> str: ...

    @property
    def bounds(self) -> Rect:
        """
        Readable always; writable for custom widgets that implement arrange() (the C++ side assigns bounds via Widget::arrange, which Python overrides).
        """

    @bounds.setter
    def bounds(self, arg: Rect, /) -> None: ...

    @property
    def children(self) -> list: ...

    def find(self, id: str) -> Widget: ...

    def set_context_menu(self, menu: Menu) -> Widget:
        """
        Right-click target for this widget and its subtree. Borrowed: keep the Menu alive on the Python side.
        """

    def set_tooltip(self, text: str) -> Widget: ...

    def add_widget(self, widget: Widget) -> Widget: ...

    def add_column(self) -> Column: ...

    def add_row(self) -> Row: ...

    def add_spacer(self) -> Spacer: ...

    def add_divider(self, horizontal: bool = True) -> Divider: ...

